# Auth DB (new — สร้าง DB ourkk ใน Postgres ก่อน)
AUTH_DATABASE_URL=postgres://postgres:password@postgres:5432/ourkk

# Solar/MEA DB (aide-collector)
DATABASE_URL=postgres://postgres:password@postgres:5432/collector
SOLAR_DEVICE_ID=                    # query: SELECT DISTINCT device_id FROM stash.solar_record
MEA_HOUSE_CA=                       # query: SELECT ca, alias FROM stash.mea_meter
MWA_ACCOUNT_CODE=                   # query: SELECT account_code FROM stash.mwa_account (เว้นว่างได้เมื่อมีบัญชีเดียว)

# better-auth
BETTER_AUTH_SECRET=                 # bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Access control (comma-separated emails)
ALLOWED_EMAILS=

# App
APP_BASE_URL=http://localhost:4321

# Socket.io
SOCKET_PORT=3000

# Shared LINE Manager transport for all alert senders
LINE_NOTICE_URL=                   # https://notice.example/v1/bots/{bot}/chats/{chat-id}/messages
LINE_NOTICE_API_KEY=
ENERGY_LIB_AVATAR_URL=https://home.ourkk.com/lib.png
ENERGY_ALERT_BATTERY_RESERVE_PCT=15
ENERGY_ALERT_BATTERY_EVENING_MAX_PCT=95
ENERGY_ALERT_SOLAR_BASELINE_MONTH=2026-07
ENERGY_ALERT_SOLAR_MIN_RATIO=0.2   # alert when 06:00-09:00 energy is below 20% of baseline

# Logging: LOG_FORMAT=text (pino-pretty) | json (raw, default prod)
LOG_LEVEL=info
LOG_FORMAT=text
