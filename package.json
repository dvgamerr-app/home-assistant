{
  "name": "home-assistant",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun x --bun astro dev",
    "dev:socket": "bun server/socket.mjs",
    "build": "bun x --bun astro build",
    "preview": "bun ./dist/server/entry.mjs",
    "check": "bun x --bun astro check",
    "lint": "bun x --bun eslint .",
    "lint:fix": "bun x --bun eslint --fix .",
    "format": "bun x --bun prettier --check .",
    "format:fix": "bun x --bun prettier --write .",
    "migration:run": "bun src/db/migrate-cli.ts",
    "prepare": "bun x --bun husky",
    "test": "bun test"
  },
  "lint-staged": {
    "*.{js,ts,mjs,cjs,svelte,astro,json,css,md}": [
      "prettier --write"
    ],
    "*.{js,ts,mjs,svelte,astro}": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@better-auth/kysely-adapter": "^1.7.7",
    "@lucide/svelte": "^1.56.0",
    "better-auth": "^1.7.7",
    "kysely": "^0.29.6",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/svelte": "^9.0.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "astro": "^7.3.8",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  }
}
