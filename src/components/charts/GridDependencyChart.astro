---
import ChartCard from '@/components/ui/ChartCard.astro'
import ChartYAxis from '@/components/ui/ChartYAxis.astro'
import LegendRow from '@/components/ui/LegendRow.astro'
import { svgStackedBars } from '@/lib/chart'
import { num } from '@/lib/electricity'
import type { SolarData } from '@/lib/solar-data'

type Props = Pick<SolarData, 'months' | 'gridOverview'>

const { months, gridOverview } = Astro.props

const [VW, VH, ML, MT, MR, MB] = [560, 180, 4, 10, 8, 24]
const [px0, py0, px1, py1] = [ML, MT, VW - MR, VH - MB]
const ph = py1 - py0

// แท่งละเดือน: ซื้อจากกริดอยู่ฐาน ใช้จากโซลาร์ซ้อนบน — สองส่วนรวมกันคือไฟที่ใช้ทั้งหมดของเดือนนั้น
const { bars, maxTotal } = svgStackedBars(
  months.map((month) => [month.gridDependencyPct, month.selfSufficiencyPct]),
  px0,
  py0,
  px1,
  py1,
  0.3,
)
const segColors = ['var(--chart-4)', 'var(--chart-1)']

// ผลิตเกินเป็นขีดบางพาดบนแท่ง อ่านคู่กันได้โดยไม่ต้องมีแกนที่สอง
const surplusMarks = bars.map((segments, index) => ({
  x: segments[0]!.x,
  w: segments[0]!.w,
  y: +(py0 + (1 - Math.min(months[index]!.solarSurplusPct, maxTotal) / maxTotal) * ph).toFixed(1),
}))

const yTicks = [1, 0.75, 0.5, 0.25]
const gridYs = yTicks.map((tick) => py0 + (1 - tick) * ph)
const yAxisTicks = yTicks.map((tick, index) => ({ label: `${num(tick * maxTotal, 0)}%`, topPct: (gridYs[index]! / VH) * 100, emphasis: index === 0 }))
const padLeft = +((ML / VW) * 100).toFixed(2)
const padRight = +((MR / VW) * 100).toFixed(2)
const latestSelfPct = Math.max(0, Math.min(100, gridOverview.selfSufficiencyPct))
const latestGridPct = Math.max(0, Math.min(100, gridOverview.gridDependencyPct))
---

<ChartCard eyebrow="พึ่งพากริด" title="สัดส่วนไฟที่ใช้" subtitle="แท่งละเดือน แยกส่วนที่ใช้จากโซลาร์กับส่วนที่ซื้อจากกริด">
  <div class="hidden gap-4 border-b border-border/60 pb-5 sm:grid sm:grid-cols-2 md:grid-cols-3">
    <div class="space-y-1">
      <p class="text-[10px] uppercase tracking-luxury text-muted-foreground">เดือนล่าสุด</p>
      <p class="font-serif text-3xl font-light text-foreground">{gridOverview.monthLabel}</p>
    </div>
    <div class="space-y-1">
      <p class="text-[10px] uppercase tracking-luxury text-muted-foreground">พึ่งพาตัวเอง</p>
      <p class="font-serif text-2xl font-light text-foreground">{num(gridOverview.selfSufficiencyPct, 0)}<span class="ml-1 text-base text-muted-foreground">%</span></p>
      <p class="text-sm text-muted-foreground">ซื้อไฟจากกริด {num(gridOverview.gridDependencyPct, 0)}%</p>
    </div>
    <div class="space-y-1">
      <p class="text-[10px] uppercase tracking-luxury text-muted-foreground">ผลิตเกินจากการใช้</p>
      <p class="font-serif text-2xl font-light text-foreground">{num(gridOverview.solarSurplusKwh, 0)}<span class="ml-1 text-base text-muted-foreground">kWh</span></p>
      <p class="text-sm text-muted-foreground">คิดเป็น {num(gridOverview.solarSurplusPct, 0)}% ของพลังงานที่ผลิตได้</p>
    </div>
  </div>

  <div class="sm:hidden">
    <div class="mb-3 flex items-baseline justify-between gap-3">
      <span class="text-[10px] uppercase tracking-luxury text-muted-foreground">{gridOverview.monthLabel}</span>
      <span class="text-xs text-muted-foreground">โซลาร์เทียบกับกริด</span>
    </div>
    <div class="flex h-3 overflow-hidden rounded-full bg-muted">
      <span class="h-full" style={`width:${latestSelfPct}%;background:var(--chart-1)`}></span>
      <span class="h-full" style={`width:${latestGridPct}%;background:var(--chart-4)`}></span>
    </div>
    <div class="mt-4 grid grid-cols-2 gap-4">
      <div>
        <p class="flex items-center gap-2 text-xs text-muted-foreground"><span class="legend-dot" style="background:var(--chart-1)"></span>ใช้จากโซลาร์</p>
        <p class="mt-1 font-serif text-3xl font-light text-foreground">{num(gridOverview.selfSufficiencyPct, 0)}%</p>
      </div>
      <div class="text-right">
        <p class="flex items-center justify-end gap-2 text-xs text-muted-foreground"><span class="legend-dot" style="background:var(--chart-4)"></span>ซื้อจากกริด</p>
        <p class="mt-1 font-serif text-3xl font-light text-foreground">{num(gridOverview.gridDependencyPct, 0)}%</p>
      </div>
    </div>
  </div>

  <div class="hidden sm:block">
    <div class="mt-5 flex items-start gap-1">
      <ChartYAxis ticks={yAxisTicks} class="h-44" />
      <div class="min-w-0 flex-1">
        <div class="h-44 w-full">
          <svg viewBox={`0 0 ${VW} ${VH}`} preserveAspectRatio="none" width="100%" height="100%">
            <line x1={px0} x2={px1} y1={py1} y2={py1} stroke="var(--border)" stroke-opacity="0.8" stroke-width="0.5"></line>
            <line x1={px0} x2={px0} y1={py0} y2={py1} stroke="var(--border)" stroke-opacity="0.8" stroke-width="0.5"></line>
            {gridYs.map((y, index) => <line x1={px0} x2={px1} y1={y} y2={y} stroke="var(--border)" stroke-opacity={index === 0 ? '0.4' : '0.8'} stroke-width="0.5" stroke-dasharray="2 4" />)}
            {
              bars.map((segments) =>
                segments.map((segment, segmentIndex) => (
                  <rect x={segment.x} y={segment.y} width={segment.w} height={segment.h} rx={segment.rx} fill={segColors[segmentIndex]} fill-opacity={segmentIndex === 0 ? '0.4' : '1'} />
                )),
              )
            }
            {surplusMarks.map((mark) => <line x1={mark.x} x2={mark.x + mark.w} y1={mark.y} y2={mark.y} stroke="var(--chart-2)" stroke-width="1.4" stroke-linecap={'round' as const} />)}
          </svg>
        </div>
        <div
          class="mt-1 grid text-[9px] tracking-wider text-muted-foreground"
          style={`grid-template-columns:repeat(${Math.max(months.length, 1)},1fr);padding-left:${padLeft}%;padding-right:${padRight}%`}
        >
          {months.map((month) => <span class="truncate text-center">{month.month}</span>)}
        </div>
      </div>
    </div>

    <LegendRow
      class="mt-3"
      items={[
        { label: 'ใช้จากโซลาร์', color: 'var(--chart-1)' },
        { label: 'ซื้อจากกริด', color: 'color-mix(in oklch, var(--chart-4) 40%, transparent)' },
        { label: 'ผลิตเกินจากการใช้ (ขีด)', color: 'var(--chart-2)' },
      ]}
    />
  </div>
</ChartCard>
