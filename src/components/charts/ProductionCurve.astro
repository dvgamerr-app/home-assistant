---
import { num } from '@/lib/electricity'
import type { SolarData } from '@/lib/solar-data'
import ChartCard from '@/components/ui/ChartCard.astro'
import LegendRow from '@/components/ui/LegendRow.astro'
import DatePicker from '@/components/ui/DatePicker.svelte'
import { buildFiveMinChartPayload } from '@/lib/solar-fivemin'
import { getBangkokISODate } from '@/lib/date'
import { SYSTEM } from '@/lib/solar-data'

const { fiveMin: POINTS, date, isToday, socketUrl } = Astro.props as Pick<SolarData, 'fiveMin'> & { date: string; isToday: boolean; socketUrl: string }
const hasData = POINTS.length > 0

const [VW, ML, MR] = [560, 4, 8]

const now = new Date()
const currentMinute = isToday ? now.getHours() * 60 + now.getMinutes() : 1439
const initialChart = buildFiveMinChartPayload(
  POINTS.map((point) => ({
    minuteOfDay: point.minuteOfDay,
    pv: point.pv,
    pv1: point.pv1 ?? 0,
    pv2: point.pv2 ?? 0,
    load: point.load,
    batt: point.batt ?? 0,
    grid: point.grid ?? 0,
  })),
  currentMinute,
)
const { peakPv, peakLoad, peakBattDis, gridPct, yLabels } = initialChart
const xLabels = Array.from({ length: 24 }, (_, i) => String(i).padStart(2, '0'))
const padLeft = +((ML / VW) * 100).toFixed(2)
const padRight = +((MR / VW) * 100).toFixed(2)

// data passed to client-side draw()
const chartJson = JSON.stringify({
  ...initialChart,
  selectedDate: date,
  today: getBangkokISODate(),
  historyStart: SYSTEM.installDate,
  isToday,
  socketUrl,
})
---

<div class="production-chart-root" data-production-chart={hasData ? chartJson : undefined}>
  <ChartCard eyebrow="พลังงาน" title={isToday ? 'กำลังผลิตวันนี้' : 'กำลังผลิตตามวันที่เลือก'} class="flex flex-col overflow-hidden">
    <div class="flex flex-wrap items-end gap-4 border-b border-border/60 pb-4 sm:gap-6 sm:pb-5">
      <div class="space-y-1">
        <p class="text-[10px] uppercase tracking-luxury text-muted-foreground">พีคโซลาร์</p>
        <p class="font-serif text-4xl font-light leading-none">
          <span id="pv-peak-pv" class="pv-peak-pv">{hasData ? num(peakPv, 2) : '—'}</span><span class="ml-1 text-base text-muted-foreground">kW</span>
        </p>
      </div>
      <div class="hidden space-y-1 sm:block">
        <p class="text-[10px] uppercase tracking-luxury text-muted-foreground">พีคโหลด</p>
        <p class="font-serif text-2xl font-light leading-none" style="color:var(--destructive)"><span id="pv-peak-load" class="pv-peak-load">{num(peakLoad, 2)}</span> kW</p>
      </div>
      <div class="hidden space-y-1 sm:block">
        <p class="text-[10px] uppercase tracking-luxury text-muted-foreground">แบตจ่ายออกสูงสุด</p>
        <p class="font-serif text-2xl font-light leading-none" style="color:var(--chart-3)"><span id="pv-peak-batt" class="pv-peak-batt">{num(peakBattDis, 2)}</span> kW</p>
      </div>
      <div class="w-full sm:ml-auto sm:flex sm:w-auto sm:items-center">
        <DatePicker selected={date} client:load />
      </div>
    </div>

    <div class="mt-4 flex items-start gap-1 sm:mt-5">
      <div id="pv-y-axis" class="pv-y-axis relative hidden h-56 shrink-0 overflow-visible sm:block md:h-60" style="width:1.75rem">
        {
          yLabels.map((l, i) => (
            <span
              class:list={['absolute right-0 text-right text-[9px] leading-none', i === 0 ? 'font-medium text-foreground/60' : 'text-muted-foreground']}
              style={`top:${gridPct[i]}%;transform:translateY(-50%)`}
            >
              {l}
            </span>
          ))
        }
      </div>
      <div class="min-w-0 flex-1">
        <div class="pv-chart-wrapper relative h-48 w-full sm:h-56 md:h-60">
          <svg
            width="100%"
            height="100%"
            role={'img' as const}
            aria-label="กราฟกำลังผลิต ซูมและเลื่อนดูข้อมูลย้อนหลังได้"
            class:list={[!hasData && 'opacity-0']}
            style="cursor:grab;touch-action:none;user-select:none;overscroll-behavior:contain"></svg>
          {
            !hasData && (
              <div class="absolute inset-0 flex items-center justify-center px-6 text-center">
                <p class="text-sm text-muted-foreground">ไม่มี telemetry สำหรับวันที่เลือก</p>
              </div>
            )
          }
        </div>
        <div id="pv-x-axis" class="pv-x-axis relative mt-1 flex h-4 justify-between text-[9px] text-muted-foreground" style={`padding-left:${padLeft}%;padding-right:${padRight}%`}>
          {xLabels.map((label, index) => <span class:list={[index % 6 === 0 || index === xLabels.length - 1 ? 'text-muted-foreground' : 'text-transparent sm:text-muted-foreground']}>{label}</span>)}
        </div>
        <div class="mt-1 flex min-h-4 flex-wrap items-center justify-between gap-x-3 gap-y-1 text-[9px] text-muted-foreground">
          <span class="pv-visible-range"></span>
          <span class="pv-load-state hidden" aria-live={'polite' as const}></span>
          <span class="hidden sm:inline">หมุนล้อเพื่อซูม · ลากไปทางขวาเพื่อดูย้อนหลัง</span>
          <span class="sm:hidden">ถ่าง 2 นิ้วเพื่อซูม · ลากเพื่อดูย้อนหลัง</span>
        </div>
      </div>
    </div>

    <LegendRow
      class="mt-3"
      items={[
        { label: 'โซลาร์ (kW)', color: 'var(--chart-2)' },
        { label: 'โหลด (kW)', color: 'var(--destructive)' },
        { label: 'แบตเตอรี่ (kW)', color: 'var(--chart-3)', mobileHidden: true },
      ]}
    >
      <span class="hidden items-center gap-2 text-xs text-muted-foreground sm:flex">
        <span class="inline-block h-px w-5 border-t-2 border-dashed opacity-70" style="border-color:var(--chart-4)"></span>
        กริด (kW)
      </span>
    </LegendRow>
  </ChartCard>

  <div class="pv-chart-tip mobile-chart-tip pointer-events-none fixed z-50 hidden rounded-lg border border-border/70 bg-card px-3 py-2.5 shadow-md" style="min-width:160px">
    <p class="pv-tip-hour mb-2 text-[10px] uppercase tracking-luxury text-muted-foreground"></p>
    <div class="space-y-1.5">
      <div class="flex items-center justify-between gap-4">
        <span class="flex items-center gap-1.5 text-[11px] text-muted-foreground">
          <span class="h-2 w-2 shrink-0 rounded-full" style="background:var(--chart-2)"></span>โซลาร์
        </span>
        <span class="pv-tip-pv font-mono text-[11px] text-foreground"></span>
      </div>
      <div class="flex items-center justify-between gap-4">
        <span class="flex items-center gap-1.5 text-[11px] text-muted-foreground">
          <span class="h-2 w-2 shrink-0 rounded-full" style="background:var(--destructive)"></span>โหลด
        </span>
        <span class="pv-tip-load font-mono text-[11px] text-foreground"></span>
      </div>
      <div class="flex items-center justify-between gap-4">
        <span class="flex items-center gap-1.5 text-[11px] text-muted-foreground">
          <span class="h-2 w-2 shrink-0 rounded-full" style="background:var(--chart-3)"></span>แบตเตอรี่
        </span>
        <span class="pv-tip-batt font-mono text-[11px] text-foreground"></span>
      </div>
      <div class="flex items-center justify-between gap-4">
        <span class="flex items-center gap-1.5 text-[11px] text-muted-foreground">
          <span class="h-2 w-2 shrink-0 rounded-full opacity-70" style="background:var(--chart-4)"></span>กริด
        </span>
        <span class="pv-tip-grid font-mono text-[11px] text-foreground"></span>
      </div>
    </div>
  </div>
</div>

<script>
  import { initProductionChart } from '@/lib/production-chart-client'

  document.querySelectorAll<HTMLElement>('.production-chart-root[data-production-chart]').forEach(initProductionChart)
</script>
