---
import { num } from '@/lib/electricity'
import type { SolarData } from '@/lib/solar-data'
import ChartCard from '@/components/ui/ChartCard.astro'
import LegendRow from '@/components/ui/LegendRow.astro'
import { getBangkokISODate } from '@/lib/date'
import { buildFiveMinChartPayload } from '@/lib/solar-fivemin'
import { SYSTEM } from '@/lib/solar-data'
import type { SolarRateChartConfig } from '@/lib/solar-rate-chart'

// interface Props ให้ astro check ตรวจ call site ได้ — `Astro.props as ...` ทำให้ prop ที่ลืมส่งเงียบ
interface Props extends Pick<SolarData, 'fiveMin'> {
  date: string
  isToday: boolean
  /** กำลังติดตั้งของ MPPT 1/2 (kWp) — ใช้เป็นฐาน 100% */
  pv1MaxKw: number
  pv2MaxKw: number
  pv1Panels: number
  pv2Panels: number
  socketUrl: string
}

const { fiveMin: POINTS, date, isToday, pv1MaxKw, pv2MaxKw, pv1Panels, pv2Panels, socketUrl } = Astro.props

const now = new Date()
const currentMinute = isToday ? now.getHours() * 60 + now.getMinutes() : 1439
const initialChart = buildFiveMinChartPayload(
  POINTS.map((point) => ({
    minuteOfDay: point.minuteOfDay,
    pv: point.pv,
    pv1: point.pv1 ?? 0,
    pv2: point.pv2 ?? 0,
    load: point.load,
    batt: point.batt ?? 0,
    grid: point.grid ?? 0,
  })),
  currentMinute,
)

// ฐานคือกำลังติดตั้งตามป้าย (panels × Wp) ไม่ใช่ peak ที่เคยทำได้
// เคยใช้ peak แล้วเจอว่าวันที่จัดสายแผงใหม่ ฐาน = ค่าสูงสุดของวันนั้นเอง → ค้างที่ 100% ตลอด
// ทะลุ 100% ได้จริงตอน cloud-edge หรือย้อนดูวันที่ layout เก่ามีแผงมากกว่า — แกน Y ขยายเป็นขั้น 25% ให้เอง
const safePv1MaxKw = Math.max(pv1MaxKw, 0.01)
const safePv2MaxKw = Math.max(pv2MaxKw, 0.01)
const peakPv1Kw = Math.max(...initialChart.pv1, 0)
const peakPv2Kw = Math.max(...initialChart.pv2, 0)
const peakPv1Pct = (peakPv1Kw / safePv1MaxKw) * 100
const peakPv2Pct = (peakPv2Kw / safePv2MaxKw) * 100
const totalCapacityKw = safePv1MaxKw + safePv2MaxKw

// สัญญาระหว่าง frontmatter กับฝั่ง client — ประกาศครั้งเดียวแล้วใช้ทั้งสองฝั่ง
const chartConfig: SolarRateChartConfig = {
  pv1: initialChart.pv1,
  pv2: initialChart.pv2,
  times: initialChart.times,
  pv1MaxKw: safePv1MaxKw,
  pv2MaxKw: safePv2MaxKw,
  selectedDate: date,
  today: getBangkokISODate(),
  historyStart: SYSTEM.installDate,
  isToday,
  socketUrl,
}
const chartJson = JSON.stringify(chartConfig)
---

<div class="solar-rate-chart-root" data-solar-rate-chart={chartJson}>
  <ChartCard eyebrow="ขีดความสามารถ" title="กำลังผลิตเทียบค่าสูงสุด" subtitle="แต่ละชุดคิดเป็นเปอร์เซ็นต์ของกำลังติดตั้งตัวเอง ซูมและเลื่อนดูย้อนหลังได้" class="overflow-hidden">
    <div slot="header-action" class="space-y-1 sm:text-right">
      <p class="text-[10px] uppercase tracking-luxury text-muted-foreground">กำลังติดตั้งรวม</p>
      <p class="font-serif text-xl font-light leading-none text-foreground sm:text-2xl">
        {num(totalCapacityKw, 2)}<span class="ml-1 text-sm text-muted-foreground">kWp</span>
      </p>
      <p class="text-[11px] text-muted-foreground">{pv1Panels} + {pv2Panels} แผง × {SYSTEM.panelWattPeak} W</p>
    </div>
    <div class="grid grid-cols-2 gap-4 border-b border-border/60 pb-4 sm:pb-5">
      <div class="space-y-1">
        <p class="text-[10px] uppercase tracking-luxury text-muted-foreground">MPPT 1 สูงสุดในช่วงที่ดู</p>
        <p class="font-serif text-4xl font-light leading-none">
          <span class="solar-rate-pv1-pct">{num(peakPv1Pct, 0)}</span><span class="ml-1 text-base text-muted-foreground">%</span>
        </p>
        {/* ตัวหารติดอยู่กับตัวตั้งเลย เพื่อให้เห็นว่า % มาจากไหนโดยไม่ต้องกวาดตาไปหาการ์ดอื่น */}
        <p class="text-sm text-chart-4">
          <span class="solar-rate-pv1-kw">{num(peakPv1Kw, 2)}</span><span class="text-muted-foreground"> / {num(safePv1MaxKw, 2)} kWp</span>
        </p>
      </div>
      <div class="space-y-1">
        <p class="text-[10px] uppercase tracking-luxury text-muted-foreground">MPPT 2 สูงสุดในช่วงที่ดู</p>
        <p class="font-serif text-4xl font-light leading-none">
          <span class="solar-rate-pv2-pct">{num(peakPv2Pct, 0)}</span><span class="ml-1 text-base text-muted-foreground">%</span>
        </p>
        <p class="text-sm text-chart-1">
          <span class="solar-rate-pv2-kw">{num(peakPv2Kw, 2)}</span><span class="text-muted-foreground"> / {num(safePv2MaxKw, 2)} kWp</span>
        </p>
      </div>
    </div>

    <div class="mt-4 flex items-start gap-1 sm:mt-5">
      <div class="solar-rate-y-axis relative hidden h-56 shrink-0 overflow-visible sm:block md:h-60" style="width:2.1rem"></div>
      <div class="min-w-0 flex-1">
        <div class="solar-rate-chart-wrapper h-48 w-full sm:h-56 md:h-60">
          <svg
            width="100%"
            height="100%"
            role={'img' as const}
            aria-label="กราฟกำลังผลิตเทียบค่าสูงสุดของแต่ละชุด ซูมและเลื่อนดูข้อมูลย้อนหลังได้"
            style="cursor:grab;touch-action:none;user-select:none;overscroll-behavior:contain"></svg>
        </div>
        <div class="solar-rate-x-axis relative mt-1 h-4 text-[9px] text-muted-foreground"></div>
        <div class="mt-1 flex min-h-4 flex-wrap items-center justify-between gap-x-3 gap-y-1 text-[9px] text-muted-foreground">
          <span class="solar-rate-visible-range"></span>
          <span class="solar-rate-load-state hidden" aria-live={'polite' as const}></span>
          <span class="hidden sm:inline">หมุนล้อเพื่อซูม · ลากไปทางขวาเพื่อดูย้อนหลัง</span>
          <span class="sm:hidden">ถ่าง 2 นิ้วเพื่อซูม · ลากเพื่อดูย้อนหลัง</span>
        </div>
      </div>
    </div>

    <LegendRow
      class="mt-3"
      items={[
        { label: 'MPPT 1', color: 'var(--chart-4)' },
        { label: 'MPPT 2', color: 'var(--chart-1)' },
      ]}
    >
      <span class="hidden items-center gap-2 text-xs text-muted-foreground sm:flex">
        <span class="inline-block h-px w-5 border-t-2 border-dashed opacity-70" style="border-color:var(--foreground)"></span>
        แต่ละเส้นเทียบกับค่าสูงสุดของชุดตัวเอง
      </span>
    </LegendRow>
  </ChartCard>

  <div class="solar-rate-tip mobile-chart-tip pointer-events-none fixed z-50 hidden rounded-lg border border-border/70 bg-card px-3 py-2.5 shadow-md" style="min-width:184px">
    <p class="solar-rate-tip-hour mb-2 text-[10px] uppercase tracking-luxury text-muted-foreground"></p>
    <div class="space-y-1.5">
      <div class="flex items-center justify-between gap-4">
        <span class="flex items-center gap-1.5 text-[11px] text-muted-foreground">
          <span class="inline-block h-px w-3 border-t-2 border-dashed opacity-80" style="border-color:var(--chart-4)"></span>MPPT 1
        </span>
        <span class="solar-rate-tip-pv1 font-mono text-[11px] text-foreground"></span>
      </div>
      <div class="flex items-center justify-between gap-4">
        <span class="flex items-center gap-1.5 text-[11px] text-muted-foreground">
          <span class="inline-block h-px w-3 border-t-2 border-dashed opacity-80" style="border-color:var(--chart-1)"></span>MPPT 2
        </span>
        <span class="solar-rate-tip-pv2 font-mono text-[11px] text-foreground"></span>
      </div>
    </div>
  </div>
</div>

<script>
  import { initSolarRateChart } from '@/lib/solar-rate-chart-client'

  document.querySelectorAll<HTMLElement>('.solar-rate-chart-root[data-solar-rate-chart]').forEach(initSolarRateChart)
</script>
