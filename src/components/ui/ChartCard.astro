---
interface Props {
  eyebrow?: string
  title?: string
  subtitle?: string
  class?: string
}
const { eyebrow, title, subtitle, class: cls } = Astro.props
const isBig = Boolean(eyebrow && !subtitle)
const hasHeaderAction = Astro.slots.has('header-action')
---

<section class:list={['rounded-lg border border-border/70 bg-card p-4 sm:p-6', cls]}>
  {
    (eyebrow || title || subtitle) && (
      <div class:list={['flex flex-col items-start justify-between gap-3 sm:flex-row sm:gap-4', isBig ? 'mb-4' : 'mb-4 sm:mb-6']}>
        <div class:list={['min-w-0', isBig ? 'space-y-1' : '']}>
          {eyebrow && <p class="text-[10px] uppercase tracking-luxury text-muted-foreground">{eyebrow}</p>}
          {title && <h2 class:list={['font-serif font-light text-foreground', isBig ? 'text-2xl' : 'text-lg']}>{title}</h2>}
          {subtitle && <p class="mt-1 hidden text-sm text-muted-foreground sm:block">{subtitle}</p>}
        </div>
        {hasHeaderAction && (
          <div class="w-full shrink-0 sm:w-auto">
            <slot name="header-action" />
          </div>
        )}
      </div>
    )
  }
  <slot />
</section>
