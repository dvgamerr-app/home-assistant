---
import Layout from '@/layouts/Layout.astro'
import { auth } from '@/lib/auth'

const session = await auth.api.getSession({ headers: Astro.request.headers })
if (!session) return Astro.redirect('/login')

const accounts = await auth.api.listUserAccounts({ headers: Astro.request.headers })
let hasPassword = accounts.some((account) => account.providerId === 'credential')
let error = ''
const passwordWasAdded = Astro.url.searchParams.get('success') === '1' && hasPassword

if (Astro.request.method === 'POST' && !hasPassword) {
  const origin = Astro.request.headers.get('origin')
  const appOrigin = new URL(process.env.APP_BASE_URL ?? Astro.url.origin).origin
  if (origin && origin !== Astro.url.origin && origin !== appOrigin) {
    error = 'คำขอไม่ถูกต้อง กรุณาโหลดหน้านี้ใหม่แล้วลองอีกครั้ง'
  } else {
    const form = await Astro.request.formData()
    const password = form.get('password')
    const confirmPassword = form.get('confirmPassword')

    if (typeof password !== 'string' || password.length < 8) {
      error = 'รหัสผ่านต้องมีอย่างน้อย 8 ตัวอักษร'
    } else if (password.length > 128) {
      error = 'รหัสผ่านต้องยาวไม่เกิน 128 ตัวอักษร'
    } else if (password !== confirmPassword) {
      error = 'รหัสผ่านทั้งสองช่องไม่ตรงกัน'
    } else {
      try {
        await auth.api.setPassword({
          body: { newPassword: password },
          headers: Astro.request.headers,
        })
        return Astro.redirect('/account/set-password?success=1', 303)
      } catch (cause) {
        const authError = cause as { body?: { code?: string; message?: string }; message?: string }
        const code = authError.body?.code

        if (code === 'PASSWORD_ALREADY_SET') {
          hasPassword = true
        } else if (code === 'PASSWORD_TOO_SHORT') {
          error = 'รหัสผ่านต้องมีอย่างน้อย 8 ตัวอักษร'
        } else if (code === 'PASSWORD_TOO_LONG') {
          error = 'รหัสผ่านต้องยาวไม่เกิน 128 ตัวอักษร'
        } else {
          error = authError.body?.message ?? authError.message ?? 'เพิ่มรหัสผ่านไม่สำเร็จ กรุณาลองใหม่อีกครั้ง'
        }
      }
    }
  }
}
---

<Layout title="เพิ่มรหัสผ่าน — บ้าน">
  <main class="flex min-h-screen items-center justify-center px-6 py-12">
    <div class="w-full max-w-sm space-y-8">
      <div class="space-y-2 text-center">
        <p class="text-[10px] uppercase tracking-luxury text-muted-foreground">ความปลอดภัยของบัญชี</p>
        <h1 class="font-serif text-3xl font-light text-foreground">เพิ่มการเข้าสู่ระบบด้วยรหัสผ่าน</h1>
        <p class="text-sm text-muted-foreground">บัญชีที่ยืนยันแล้ว: {session.user.email}</p>
      </div>

      <div class="rounded-xl border border-border/70 bg-card p-8">
        {
          passwordWasAdded ? (
            <div class="space-y-5 text-center">
              <p class="text-sm text-foreground">เพิ่มรหัสผ่านให้บัญชีนี้เรียบร้อยแล้ว ต่อไปสามารถเข้าสู่ระบบได้ทั้ง GitHub และอีเมลพร้อมรหัสผ่าน</p>
              <a href="/" class="block w-full rounded-md border border-accent/60 bg-accent/10 px-4 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-accent/20">
                ไปยังหน้าหลัก
              </a>
            </div>
          ) : hasPassword ? (
            <div class="space-y-5 text-center">
              <p class="text-sm text-foreground">บัญชีนี้มีรหัสผ่านอยู่แล้ว สามารถเข้าสู่ระบบด้วยอีเมลและรหัสผ่านเดิมได้</p>
              <a href="/" class="block w-full rounded-md border border-border/70 px-4 py-2.5 text-sm text-foreground transition-colors hover:bg-background">
                ไปยังหน้าหลัก
              </a>
            </div>
          ) : (
            <form method="POST" class="space-y-5">
              {error && <p class="rounded-md border border-destructive/50 bg-destructive/5 px-4 py-3 text-sm text-destructive">{error}</p>}

              <div class="space-y-1.5">
                <label for="password" class="text-[10px] uppercase tracking-luxury text-muted-foreground">
                  รหัสผ่านใหม่
                </label>
                <input
                  id="password"
                  name="password"
                  type="password"
                  required
                  minlength="8"
                  maxlength="128"
                  autocomplete="new-password"
                  class="w-full rounded-md border border-border/70 bg-background px-4 py-2.5 text-sm text-foreground outline-none focus:border-accent"
                />
              </div>

              <div class="space-y-1.5">
                <label for="confirmPassword" class="text-[10px] uppercase tracking-luxury text-muted-foreground">
                  ยืนยันรหัสผ่านใหม่
                </label>
                <input
                  id="confirmPassword"
                  name="confirmPassword"
                  type="password"
                  required
                  minlength="8"
                  maxlength="128"
                  autocomplete="new-password"
                  class="w-full rounded-md border border-border/70 bg-background px-4 py-2.5 text-sm text-foreground outline-none focus:border-accent"
                />
              </div>

              <button type="submit" class="w-full rounded-md border border-accent/60 bg-accent/10 px-4 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-accent/20">
                เพิ่มรหัสผ่านให้บัญชีนี้
              </button>

              <p class="text-xs text-muted-foreground">รหัสผ่านต้องมี 8–128 ตัวอักษร และจะถูกผูกกับบัญชีเดียวกันโดยไม่สร้างผู้ใช้ซ้ำ</p>
            </form>
          )
        }
      </div>
    </div>
  </main>
</Layout>
