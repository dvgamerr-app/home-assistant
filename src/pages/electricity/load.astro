---
import Layout from '@/layouts/Layout.astro'
import Nav from '@/components/Nav.astro'
import ElectricityNav from '@/components/ElectricityNav.astro'
import PageHeader from '@/components/ui/PageHeader.astro'
import DailyView from '@/components/DailyView.astro'
import SolarDaySummary from '@/components/SolarDaySummary.astro'
import { getLoadPageData, getMonthLoad } from '@/lib/solar-data'

const now = new Date()
const curYear = now.getFullYear()
const curMonth = now.getMonth() + 1

const mParam = Astro.url.searchParams.get('m')
let selYear = curYear,
  selMonth = curMonth
if (mParam && /^\d{6}$/.test(mParam)) {
  selYear = parseInt(mParam.slice(0, 4))
  selMonth = Math.max(1, Math.min(12, parseInt(mParam.slice(4, 6))))
}
const isCurrentMonth = selYear === curYear && selMonth === curMonth
const selectedMonthStr = `${selYear}${String(selMonth).padStart(2, '0')}`

// เดือนล่าสุดที่ข้อมูลครบ (M-1) กับเดือนก่อนหน้านั้น (M-2) — ใช้เทียบกันเสมอ ไม่ขึ้นกับเดือนที่กำลังดู
const lastFullDate = new Date(curYear, curMonth - 2, 1)
const twoMonthsAgoDate = new Date(curYear, curMonth - 3, 1)

const [data, selMonthData] = await Promise.all([getLoadPageData(), isCurrentMonth ? Promise.resolve(null) : getMonthLoad(selYear, selMonth)])

const monthKey = (date: Date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}`
const [lastMonthData, twoMonthsAgoData] = await Promise.all([
  data.monthSummaries.find((entry) => entry.key === monthKey(lastFullDate)) ?? getMonthLoad(lastFullDate.getFullYear(), lastFullDate.getMonth() + 1),
  data.monthSummaries.find((entry) => entry.key === monthKey(twoMonthsAgoDate)) ?? getMonthLoad(twoMonthsAgoDate.getFullYear(), twoMonthsAgoDate.getMonth() + 1),
])

// เดือนที่มีข้อมูลจริงใน DB (จาก getMonths(12) ใน getAll)
const availableMonths = data.monthPicker

const monthDays = isCurrentMonth ? data.monthDays : selMonthData!.days
const monthLabel = isCurrentMonth ? data.monthLabel : selMonthData!.label
---

<Layout title="การใช้ไฟในบ้าน — บ้าน">
  <Nav />
  <main class="space-y-8 px-6 py-10 md:px-10 md:py-12">
    <PageHeader eyebrow="ระบบไฟฟ้า" title="ข้อมูลพลังงาน" />

    <ElectricityNav active="load" />

    <SolarDaySummary dayFlow={data.dayFlow} dayComparison={data.dayComparison} />

    <DailyView
      today={data.today}
      day={data.day}
      monthDays={monthDays}
      monthLabel={monthLabel}
      isCurrentMonth={isCurrentMonth}
      selMonthTotals={selMonthData?.totals}
      lastMonth={lastMonthData}
      twoMonthsAgo={twoMonthsAgoData}
      availableMonths={availableMonths}
      selectedMonth={selectedMonthStr}
    />
  </main>
</Layout>
