---
import Layout from '@/layouts/Layout.astro'
import Nav from '@/components/Nav.astro'
import SettingsPanel from '@/components/SettingsPanel.svelte'
import KeyRound from '@lucide/svelte/icons/key-round'
import ShieldCheck from '@lucide/svelte/icons/shield-check'
import { auth } from '@/lib/auth'

const session = await auth.api.getSession({ headers: Astro.request.headers })
if (!session) return Astro.redirect('/login')

const accounts = await auth.api.listUserAccounts({ headers: Astro.request.headers })
const hasPassword = accounts.some((account) => account.providerId === 'credential')
const hasGitHub = accounts.some((account) => account.providerId === 'github')
const twoFactorEnabled = session.user.twoFactorEnabled ?? false
const displayName = session.user.name?.trim() || session.user.email.split('@')[0]
const parts = displayName.split(/\s+/).filter(Boolean)
const initials = (parts.length > 1 ? parts[0][0] + parts[1][0] : displayName.slice(0, 2)).toUpperCase()
---

<Layout title="ตั้งค่าบัญชี — บ้าน" description="จัดการโปรไฟล์และความปลอดภัยของบัญชี OurKK">
  <Nav />

  <main class="mx-auto max-w-6xl space-y-8 px-6 py-10 md:px-10 md:py-12">
    <header class="grid gap-6 border-b border-border/60 pb-8 md:grid-cols-[1fr_auto] md:items-end">
      <div class="space-y-3">
        <p class="text-[11px] uppercase tracking-luxury text-muted-foreground">Settings · Account</p>
        <h1 class="font-serif text-4xl font-light leading-tight text-foreground md:text-5xl">โปรไฟล์และความปลอดภัย</h1>
        <p class="max-w-2xl text-sm leading-relaxed text-muted-foreground">ตั้งชื่อที่ใช้ภายในบ้าน ตรวจสอบวิธีเข้าสู่ระบบ และเพิ่มการยืนยันสองขั้นตอนให้บัญชี</p>
      </div>

      <div class="flex items-center gap-4 md:justify-end">
        <div
          aria-hidden={true}
          class="flex h-14 w-14 items-center justify-center rounded-full border border-foreground/70 bg-foreground font-serif text-base font-light tracking-wider text-primary-foreground"
        >
          {initials}
        </div>
        <div class="min-w-0">
          <p class="max-w-64 truncate font-serif text-lg font-light text-foreground">{displayName}</p>
          <p class="max-w-64 truncate text-xs text-muted-foreground">{session.user.email}</p>
        </div>
      </div>
    </header>

    <section class="grid gap-px overflow-hidden rounded-xl border border-border/70 bg-border/70 sm:grid-cols-3" aria-label="ภาพรวมบัญชี">
      <div class="flex items-center gap-3 bg-card px-5 py-4">
        <KeyRound class="text-muted-foreground" size={17} strokeWidth={1.25} />
        <div>
          <p class="text-[10px] uppercase tracking-luxury text-muted-foreground">Email login</p>
          <p class="mt-1 text-sm text-foreground">{hasPassword ? 'พร้อมใช้งาน' : 'ยังไม่ได้เพิ่ม'}</p>
        </div>
      </div>
      <div class="flex items-center gap-3 bg-card px-5 py-4">
        <svg class="h-[17px] w-[17px] text-muted-foreground" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12Z"
          ></path>
        </svg>
        <div>
          <p class="text-[10px] uppercase tracking-luxury text-muted-foreground">GitHub</p>
          <p class="mt-1 text-sm text-foreground">{hasGitHub ? 'เชื่อมต่อแล้ว' : 'ยังไม่เชื่อมต่อ'}</p>
        </div>
      </div>
      <div class="flex items-center gap-3 bg-card px-5 py-4">
        <ShieldCheck class={twoFactorEnabled ? 'text-chart-1' : 'text-muted-foreground'} size={17} strokeWidth={1.25} />
        <div>
          <p class="text-[10px] uppercase tracking-luxury text-muted-foreground">Two-factor</p>
          <p class:list={['mt-1 text-sm', twoFactorEnabled ? 'text-chart-1' : 'text-foreground']}>{twoFactorEnabled ? 'เปิดป้องกันอยู่' : 'ยังไม่เปิด'}</p>
        </div>
      </div>
    </section>

    <SettingsPanel client:load initialName={displayName} email={session.user.email} initialTwoFactorEnabled={twoFactorEnabled} hasPassword={hasPassword} />
  </main>
</Layout>
